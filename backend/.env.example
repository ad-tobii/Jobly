# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Used to build the Gmail OAuth redirect back into the app.
FRONTEND_URL=http://localhost:5173

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project settings → API. The SERVICE key bypasses RLS — server-side only,
# never expose it to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Redis (BullMQ queues) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI providers ─────────────────────────────────────────────────────────────
# Groq: CV parsing, quality scoring, job requirement extraction.
GROQ_API_KEY=gsk_your_groq_key
# Fireworks: tailored CV + cover letter generation.
FIREWORKS_KEY=fw_your_fireworks_key

# ── Job scraping ─────────────────────────────────────────────────────────────
# Base URL of the LinkedIn scraper service the scrape worker calls.
SCRAPER_URL=http://localhost:8000

# ── Gmail integration (optional) ─────────────────────────────────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Needed only if you want Jobly to watch an inbox for LinkedIn job alerts.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# ── Webhooks (optional) ──────────────────────────────────────────────────────
# Shared secret checked on POST /webhooks/notify (x-webhook-secret header).
WEBHOOK_SECRET=generate-a-long-random-string
# n8n endpoint the digest worker posts the daily summary to.
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/jobly-digest

# ── PDF rendering ────────────────────────────────────────────────────────────
# puppeteer-core ships no browser. Set this if Chrome isn't at a standard
# path — see resolveChromePath() in src/workers/docgenWorker.js.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
